# ==============================================================================
# BrandGuard AI — Environment Configuration Example
# ==============================================================================
# Database Configuration
DATABASE_URL=sqlite:///./brandguard.db

# Security & Session Secrets (Replace with random cryptographic key in production)
SECRET_KEY=brandguard-hackathon-2026-secret-key-change-me

# Provider-Agnostic LLM Configuration (Optional)
# If AI_API_KEY is omitted or blank, BrandGuard AI seamlessly operates in
# transparent Deterministic Engine Mode with zero hallucination risk.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=15.0

# CORS & Server Port
PORT=8000
HOST=127.0.0.1
